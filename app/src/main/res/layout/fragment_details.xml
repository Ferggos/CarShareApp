<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <LinearLayout
        android:id="@+id/llCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:paddingHorizontal="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center">

        <ImageButton
            android:id="@+id/ibBack"
            android:layout_width="23dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:contentDescription="@string/goback"
            app:srcCompat="@drawable/ic_arrowback" />

        <TextView
            android:id="@+id/tvWelcomeText"
            style="@style/Header2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1111"
            android:text="Детали"
            android:textAlignment="center" />

        <ImageButton
            android:id="@+id/ibFavorite"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:tag = "favorite"
            android:background="@color/transparent"
            android:contentDescription="@string/goback"
            app:srcCompat="@drawable/ic_favorite" />


    </LinearLayout>

    <!-- Image -->
    <ImageView
        android:id="@+id/car_image"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:scaleType="fitXY"
        android:src="@drawable/photo_tesla"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/llCreateAccount" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/car_image">


        <!-- Title -->
        <TextView
            android:id="@+id/car_title"
            style="@style/Header1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tesla Model 3 2019" />

        <TextView
            android:id="@+id/tvAddress"
            style="@style/BaseText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Адрес нахождения" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/address_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Адрес автомобиля"
                android:src="@drawable/ic_car_adress" />

            <TextView
                android:id="@+id/textAddress"
                style="@style/BaseText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Авиамоторная ул., 8, стр. 2" />
        </LinearLayout>

        <!-- Description Label -->
        <TextView
            android:id="@+id/description_label"
            style="@style/Header3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Описание" />

        <!-- Description Text -->
        <TextView
            android:id="@+id/textDescp"
            style="@style/BaseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tesla Model 3 оснащена электрическим двигателем, который обеспечивает 460 лошадиных сил. Полный привод" />

    </LinearLayout>
    <!-- Price and Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="70dp"
        android:paddingHorizontal="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvPrice"
            style="@style/Header3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="2500₽/день" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/book_button"
            style="@style/BtnFillStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Забронировать" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
