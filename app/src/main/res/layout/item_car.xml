<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:layout_margin="20dp"
    android:padding="10dp"
    android:background="@drawable/item_border">

    <!-- Inner layout for content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Left container for text and buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <!-- Car name (model) -->
                    <TextView
                        android:id="@+id/carName"
                        style="@style/Header3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S 500 Sedan" />

                    <!-- Car brand (e.g., Mercedes-Benz) -->
                    <TextView
                        android:id="@+id/carBrand"
                        style="@style/SideText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mercedes-Benz" />

                    <!-- Car price per day -->
                    <TextView
                        android:id="@+id/carPrice"
                        style="@style/Header3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="2500₽ в день" />

                    <!-- Car transmission and fuel type -->
                    <TextView
                        android:id="@+id/carTransmissionFuel"
                        style="@style/SideText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="A/T • Бензин" />
                </LinearLayout>

                <!-- Car image on the right side -->
                <ImageView
                    android:id="@+id/carImage"
                    android:layout_width="200dp"
                    android:layout_height="130dp"
                    android:src="@drawable/logo_mercedes"
                    android:scaleType="fitCenter"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>

            <!-- Buttons for booking and details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/bookButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/BtnFillStyle"
                    android:text="Забронировать" />

                <Button
                    android:id="@+id/detailsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Детали"
                    style="@style/BtnOutlineStyle" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>